APP_ENV=development

PORT=8080
DATABASE_URL=postgres://jobcopilot:jobcopilot@127.0.0.1:5432/jobcopilot
DATABASE_MAX_CONNECTIONS=5
RUN_DB_MIGRATIONS=true

JWT_SECRET=replace-me-for-local-dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

ML_SIDECAR_BASE_URL=http://localhost:8000
ML_SIDECAR_TIMEOUT_SECONDS=90
ML_RETRAIN_THRESHOLD=15
ML_RETRAIN_POLL_INTERVAL_SECONDS=21600

# Enrichment provider. `template` is deterministic and requires no model.
# For local semantic explanations, run Ollama and set this to `ollama`.
ML_LLM_PROVIDER=template
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
ML_LLM_REQUEST_TIMEOUT_SECONDS=90

# Comma-separated ingestion daemon sources. Robota.ua is intentionally opt-in while
# its HTTP API requires a Cloudflare browser challenge.
SCRAPE_SOURCES=djinni,douua,workua
SCRAPE_PAGES=3
SCRAPE_INTERVAL_MINUTES=60

RERANKER_RUNTIME_MODE=deterministic
LEARNED_RERANKER_ENABLED=true
TRAINED_RERANKER_ENABLED=false
TRAINED_RERANKER_MODEL_PATH=

METRICS_PORT=9090

# Grafana
GRAFANA_ADMIN_PASSWORD=change-me-in-prod
